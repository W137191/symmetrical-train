<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_app"
    android:fitsSystemWindows="true">

    <!-- 顶栏：左右各 48dp 占位，使标题真正居中；右侧显示当前修复引擎 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_toolbar"
        android:paddingStart="@dimen/space_sm"
        android:paddingEnd="@dimen/space_sm">

        <View
            android:layout_width="@dimen/space_xl"
            android:layout_height="1dp" />

        <TextView
            style="@style/Widget.PsApk.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/tvEngine"
            style="@style/Widget.PsApk.EngineBadge"
            android:layout_width="@dimen/space_xl"
            android:layout_height="wrap_content"
            android:text="@string/engine_fmm" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 画布：weight 自适应 + minHeight 防止小屏/横屏被挤压到消失 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="@dimen/canvas_min_height"
        android:layout_marginStart="@dimen/page_padding"
        android:layout_marginEnd="@dimen/page_padding"
        android:layout_marginTop="@dimen/space_sm"
        android:background="@drawable/bg_canvas_frame">

        <com.example.psapk.EditView
            android:id="@+id/editView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <!-- 空状态：常驻引导，替代原先纯黑无提示 -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_lg">

            <ImageView
                android:layout_width="@dimen/empty_icon_size"
                android:layout_height="@dimen/empty_icon_size"
                android:src="@drawable/ic_image_placeholder"
                android:contentDescription="@null" />

            <TextView
                style="@style/Widget.PsApk.EmptyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/empty_main_title" />

            <TextView
                style="@style/Widget.PsApk.EmptySub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/empty_main_sub" />
        </LinearLayout>

        <!-- 忙碌遮罩：处理中常驻反馈并屏蔽误触 -->
        <LinearLayout
            android:id="@+id/busyOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_overlay"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent" />

            <TextView
                style="@style/Widget.PsApk.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/busy_processing" />
        </LinearLayout>
    </FrameLayout>

    <!-- 工具区独立滚动：横屏/小屏也能触达全部按钮，且不会挤掉画布 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.95"
        android:layout_marginTop="@dimen/space_sm"
        android:paddingStart="@dimen/page_padding"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="@dimen/space_sm"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 常驻状态行：笔刷大小 / 模式 / 蒙版 / 对比，取代「只能靠 Toast 猜状态」 -->
            <TextView
                android:id="@+id/tvStatusLine"
                style="@style/Widget.PsApk.StatusLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status"
                android:paddingStart="@dimen/space_sm"
                android:paddingEnd="@dimen/space_sm"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/status_initial" />

            <!-- 01 选图与检测 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnGallery"
                    style="@style/Widget.PsApk.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:drawableStart="@drawable/ic_gallery"
                    android:drawablePadding="@dimen/space_xs"
                    android:contentDescription="@string/cd_gallery"
                    android:text="@string/gallery" />

                <Button
                    android:id="@+id/btnCamera"
                    style="@style/Widget.PsApk.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:drawableStart="@drawable/ic_camera"
                    android:drawablePadding="@dimen/space_xs"
                    android:contentDescription="@string/cd_camera"
                    android:text="@string/camera" />

                <Button
                    android:id="@+id/btnAuto"
                    style="@style/Widget.PsApk.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_auto"
                    android:drawablePadding="@dimen/space_xs"
                    android:contentDescription="@string/cd_auto"
                    android:text="@string/auto_detect" />
            </LinearLayout>

            <!-- 02 涂抹与查看（切换型按钮使用 Toggle 样式，选中常驻高亮） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnBrushMinus"
                    style="@style/Widget.PsApk.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:text="@string/brush_minus" />

                <Button
                    android:id="@+id/btnBrushPlus"
                    style="@style/Widget.PsApk.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:text="@string/brush_plus" />

                <Button
                    android:id="@+id/btnErase"
                    style="@style/Widget.PsApk.Button.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:text="@string/erase" />

                <Button
                    android:id="@+id/btnMask"
                    style="@style/Widget.PsApk.Button.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mask" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCompare"
                    style="@style/Widget.PsApk.Button.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:text="@string/compare" />

                <Button
                    android:id="@+id/btnUndo"
                    style="@style/Widget.PsApk.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:text="@string/undo" />

                <Button
                    android:id="@+id/btnReset"
                    style="@style/Widget.PsApk.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/reset" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@color/divider" />

            <!-- 03 主操作：全局唯一的强调色按钮，形成视觉焦点 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnProcess"
                    style="@style/Widget.PsApk.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:drawableStart="@drawable/ic_fix"
                    android:drawablePadding="@dimen/space_xs"
                    android:contentDescription="@string/cd_fix"
                    android:text="@string/process" />

                <Button
                    android:id="@+id/btnSave"
                    style="@style/Widget.PsApk.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/cd_save"
                    android:text="@string/save" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@color/divider" />

            <!-- 更多功能：入口按钮不再占据画布上方两整行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCostume"
                    style="@style/Widget.PsApk.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:text="@string/entry_costume" />

                <Button
                    android:id="@+id/btnTryOn"
                    style="@style/Widget.PsApk.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/entry_tryon" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
